# ── Redis (local Docker) ──
# Después de `docker compose up -d`, usa estos valores:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── OpenRouter (IA del Cockpit) ──
# Obtén tu API key en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=GCX Cockpit Ejecutivo

# ── RECO API ──
RECO_API_URL=http://rws.grucas.com:19287/api/reco/encoded
